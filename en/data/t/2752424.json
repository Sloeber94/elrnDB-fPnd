[[1,1,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/2046134.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[2,1,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>Position the vehicle on a lift.</p><p>Raise the vehicle.</p><p><a href=\"#/169001885\">Op. 7055B54 UNDER-ENGINE GUARD - R R</a></p><p>1. Undo the plug and drain the engine oil into a suitable container.</p><p>Keep the metal gasket underneath.</p><aside class=\"note\"><img class=\"icon\" src=\"../media/767.jpg\" alt=\"\" loading=\"lazy\"><p>The engine oil used contains substances that are harmful to the environment. These substances should be placed in specially designed containers.</p></aside><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/2046134.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[2,1,0,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>Replace the metal gasket.</p><p>Tighten the engine oil drain plug.</p><p><a href=\"#/169001885\">Op. 7055B54 UNDER-ENGINE GUARD - R R</a></p><p>Lower the vehicle.</p><p><a href=\"#/2752376\">Op. 0010T11 ENGINE OIL CHECK LEVEL AND TOP UP</a></p><p>Remove the vehicle from the lift.</p>"],[4,1,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/169000440.jpg\" alt=\"\" loading=\"lazy\"></figure>"]]