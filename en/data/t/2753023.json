[[7,1,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>Disconnect the battery negative\nterminal.</p><p>Place the car on a lift.</p><p>1. Release the parking sensor from the housing in the rear bumper.</p><p>2. Disconnect the electrical connection.</p><div class=\"table\"><table><tr><th><figure class=\"diagram\"><img class=\"zoomable\" src=\"../media/2001294.svg\" alt=\"\" loading=\"lazy\"></figure></th><th><p>Name</p></th><th colspan=\"1\"><p>Connector</p></th></tr><tr><td><p>2</p></td><td><p>Parking sensor unit</p></td><td colspan=\"1\"><p><strong>K97A</strong></p></td></tr></table></div><div class=\"table\"><table><tr><th><figure class=\"diagram\"><img class=\"zoomable\" src=\"../media/2001294.svg\" alt=\"\" loading=\"lazy\"></figure></th><th><p>Name</p></th><th colspan=\"1\"><p>Connector</p></th></tr><tr><td><p>2</p></td><td><p>Parking sensor unit</p></td><td colspan=\"1\"><p><strong>K97B</strong></p></td></tr></table></div><div class=\"table\"><table><tr><th><figure class=\"diagram\"><img class=\"zoomable\" src=\"../media/2001294.svg\" alt=\"\" loading=\"lazy\"></figure></th><th><p>Name</p></th><th colspan=\"1\"><p>Connector</p></th></tr><tr><td><p>2</p></td><td><p>Parking sensor unit</p></td><td colspan=\"1\"><p><strong>K97C</strong></p></td></tr></table></div><div class=\"table\"><table><tr><th><figure class=\"diagram\"><img class=\"zoomable\" src=\"../media/2001294.svg\" alt=\"\" loading=\"lazy\"></figure></th><th><p>Name</p></th><th colspan=\"1\"><p>Connector</p></th></tr><tr><td><p>2</p></td><td><p>Parking sensor unit</p></td><td colspan=\"1\"><p><strong>K97D</strong></p></td></tr></table></div><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/2064854.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[7,1,0,"<h3 c