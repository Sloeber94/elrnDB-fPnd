[[7,1,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/169002762.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[4,1,2097152,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>Disconnect the negative battery terminal.</p><p>1. Working inside the engine compartment, remove the access cover to the bulbs.</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/169002763.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[4,1,2097152,"<p>1. Disconnect the electrical connection.</p><p>2. Undo the clip.</p><p>3. Remove the bulb.</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/169002764.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[4,1,2097152,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>1. Fit the bulb in its seat.</p><p>2. Secure the bulb with the clip.</p><p>3. Connect the electrical connection.</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/169002765.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[4,1,2097152,"<p>1. Fit the bulb access cover in its seat.</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/169002766.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[4,1,2097152,"<p>Connect the negative battery terminal.</p>"]]