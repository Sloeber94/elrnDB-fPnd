[[4,1,2097152,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>Disconnect the negative battery terminal.</p><p>1. Undo the retaining bolts.</p><p>2. Remove the surround.</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/169002775.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[4,1,2097152,"<p>1. Release the electrical connection and disconnect.</p><div class=\"table\"><table><tr><th></th><th><p>Description</p></th><th><p>Connector</p></th></tr><tr><td><p>1</p></td><td><p>Left front direction indicator</p></td><td><p>F018</p></td></tr></table></div><div class=\"table\"><table><tr><th></th><th><p>Description</p></th><th><p>Connector</p></th></tr><tr><td><p>1</p></td><td><p>Right front direction indicator</p></td><td><p>F019</p></td></tr></table></div><p>2. Undo the retaining bolts.</p><p>3. Remove the direction indicator.</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/169002776.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[4,1,2097152,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>1. Fit the direction indicator in its seat.</p><p>2. Tighten the fixing bolts.</p><p>3. Connect the electrical connection and secure to the fastening.</p><div class=\"table\"><table><tr><th></th><th><p>Description</p></th><th><p>Connector</p></th></tr><tr><td><p>3</p></td><td><p>Left front direction indicator</p></td><td><p>F018</p></td></tr></table></div><div class=\"table\"><table><tr><th></th><th><p>Description</p></th><th><p>Connector</p></th></tr><tr><td><p>3</p></td><td><p>Right front direction indicator</p></td><td><p>F019</p></td></tr></table></div><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/169002777.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[4,1,2097152,"<p>1. Fit the panel in position.</p><p>2. Tighten the fixing bolts.</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/169002778.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[4,1,2097152,"<p>Connect the negative battery terminal.</p>"]]