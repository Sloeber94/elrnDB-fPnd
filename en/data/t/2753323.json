[[7,1,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>1. Undo retaining bolts</p><p>2. Release the sun visor and remove it.</p><p>3. Undo retaining bolts</p><p>4. Remove the mount.</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/2047315.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[7,1,0,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>Position the mounting and tighten\nthe fixing bolt.</p><p>Position the sun visor and tighten the\nfixing bolt.</p>"]]