[[7,1,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>1. Open the fixing bolt cover plugs.</p><p>2. Undo the retaining bolts.</p><p>3. Remove the grab handle.</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/2047313.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[7,1,0,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>Position the grab handle.</p><p>Tighten the bolts.</p><p>Close the fixing bolt cover plugs.</p>"]]