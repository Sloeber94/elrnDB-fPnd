[[1,1,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>1. Open the air filter cover fastenings.</p><p>2. Remove the air filter cover.</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/2046215.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[2,1,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>1. Open the air filter cover fastenings.</p><p>2. Remove the air filter cover.</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/2046215.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[4,1,0,"<h3 class=\"step\" data-step=\"removing\" data-part=\"removal\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</h3><a class=\"jump\" href=\"#\" data-jump=\"refitting\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</a><p>1. Undo the bolts (1a) and remove the air filter cover (1b).</p><p>2. Remove the gasket</p><p>3. Remove the air filter filter element.</p><aside class=\"note\"><img class=\"icon\" src=\"../media/767.jpg\" alt=\"\" loading=\"lazy\"><p>Before fitting a new filter element,\nremove any impurities in the filter casing (by suction) that could\nfall into the clean air section of the circuit.</p></aside><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/2064450.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[1,1,0,"<p>1. Remove the filter element.</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/2046216.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[2,1,0,"<p>1. Remove the filter element.</p><figure class=\"photo\"><img class=\"zoomable\" src=\"../media/2046216.jpg\" alt=\"\" loading=\"lazy\"></figure>"],[4,1,0,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>Fit a new air filter filter element in\nplace.</p><p>Fit the gasket in place.</p><p>Fit the the air filter cover in place and\nfix it using the bolts.</p>"],[1,1,0,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>Fit a new filter element.</p><p>Fit the air filter cover and close the\nfastening clip for the cover on the casing.</p>"],[2,1,0,"<h3 class=\"step\" data-step=\"refitting\" data-part=\"refit\"><img class=\"icon\" src=\"../media/21.jpg\" alt=\"\" loading=\"lazy\">Refitting</h3><a class=\"jump\" href=\"#\" data-jump=\"removing\"><img class=\"icon\" src=\"../media/20.jpg\" alt=\"\" loading=\"lazy\">Removing</a><p>Fit a new filter element.</p><p>Fit the air filter cover and close the\nfastening clip for the cover on the casing.</p>"]]